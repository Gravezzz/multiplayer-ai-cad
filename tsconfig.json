{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "noEmit": true, "resolveJsonModule": true,
    "experimentalDecorators": false, "useDefineForClassFields": true
  },
  "include": ["src", "server", "packages", "tests", "vite.config.ts"],
  "exclude": ["node_modules", "actors"]
}
